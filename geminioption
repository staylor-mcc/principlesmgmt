<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Principles of Management - Lesson Prompt Generator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
        .serif-title {
            font-family: 'Playfair Display', Georgia, serif;
        }
        /* Custom scrollbar for better visual aesthetics */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased selection:bg-teal-500 selection:text-white">

    <!-- Header & Brand Bar -->
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-gradient-to-tr from-teal-500 to-emerald-600 rounded-xl text-white shadow-md shadow-teal-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </div>
                <div>
                    <span class="text-xs uppercase tracking-widest text-slate-400 font-bold">Community College Hub</span>
                    <h1 class="text-lg font-extrabold text-slate-900 leading-none">Pedagogy Architect</h1>
                </div>
            </div>
            <div class="flex items-center space-x-2 bg-slate-100 p-1.5 rounded-lg border border-slate-200">
                <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-white text-slate-700 shadow-sm">Principles of Management</span>
                <span class="px-2 py-1 text-xs text-slate-500 font-medium">v2.5-Bloom</span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero intro section -->
        <div class="mb-8 text-center sm:text-left">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 serif-title mb-2">Dynamic Lesson Prompt Generator</h2>
            <p class="text-slate-600 max-w-3xl text-sm sm:text-base leading-relaxed">
                Design custom, rigorous, and highly engaging lesson plans for your Principles of Management course. This tool structures complex instructional prompts featuring real-world community ties, Bloom's Taxonomy, robust AI-cheating mitigation, and strict ADA compliance.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT INPUT PANEL (7 Columns) -->
            <section class="lg:col-span-7 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 space-y-8">
                
                <!-- PRESET SYLLABUS EXPEDITER -->
                <div class="bg-gradient-to-r from-teal-50 to-emerald-50 rounded-xl p-5 border border-teal-100 relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 text-teal-100 opacity-60">
                        <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
                        </svg>
                    </div>
                    <div class="relative">
                        <h3 class="text-sm font-bold text-teal-900 uppercase tracking-wider mb-2 flex items-center">
                            <span class="mr-1.5 flex h-2 w-2 rounded-full bg-teal-500 animate-ping"></span>
                            Syllabus Integration Quick-Load
                        </h3>
                        <p class="text-xs text-teal-800 mb-3 leading-relaxed">
                            Select an essential Principles of Management course module from our built-in syllabus template to automatically populate matching lesson details, Bloom's objectives, and key topics.
                        </p>
                        <select id="syllabus-selector" onchange="loadSyllabusModule()" class="w-full bg-white border border-teal-200 rounded-lg py-2 px-3 text-slate-700 font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 shadow-sm transition">
                            <option value="">-- Choose Course Module --</option>
                            <!-- Dynamically loaded in script -->
                        </select>
                    </div>
                </div>

                <!-- FORM CONTROLS -->
                <form id="prompt-form" class="space-y-6" oninput="generatePromptText()">
                    
                    <!-- 1. Lesson Basics -->
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center space-x-2 border-b border-slate-100 pb-2 mb-4">
                            <span class="bg-indigo-100 text-indigo-600 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold">1</span>
                            <span>Lesson Demographics & Scope</span>
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Audience Level</label>
                                <select id="audience" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Community College students, often balancing work/life commitments, career-focused or preparing for transfer.">Community College Students (Work/Life focus)</option>
                                    <option value="Traditional first and second-year undergraduate business majors.">Traditional Lower-Division Undergraduates</option>
                                    <option value="Non-traditional, adult learners seeking professional certifications.">Adult Learners / Professional Track</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Course Format & Pace</label>
                                <select id="format" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Online 16-week course (regular paced, highly structured, deep reflections).">Online 16-Week Course (Standard)</option>
                                    <option value="Online 8-week accelerated class (hyper-focused, fast pacing, streamlined assignments).">Online 8-Week Course (Accelerated)</option>
                                    <option value="Hybrid format (online content delivery paired with hands-on weekly workshops).">Hybrid Format (Blended)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Lesson Title</label>
                            <input type="text" id="lesson-title" placeholder="e.g., Tactical Planning & SWOT Analyses" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                    </div>

                    <!-- 2. Learning Objectives (Bloom's Taxonomy) -->
                    <div>
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-4">
                            <h3 class="text-base font-bold text-slate-900 flex items-center space-x-2">
                                <span class="bg-indigo-100 text-indigo-600 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold">2</span>
                                <span>Bloom's Taxonomy Objectives</span>
                            </h3>
                            <button type="button" onclick="toggleBloomsGuide()" class="text-xs text-indigo-600 hover:text-indigo-800 hover:underline flex items-center font-semibold">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Verbs Guide
                            </button>
                        </div>

                        <!-- Bloom's Taxonomy interactive picker helper -->
                        <div id="blooms-guide" class="hidden bg-indigo-50/70 border border-indigo-100 rounded-xl p-4 mb-4 space-y-3">
                            <h4 class="text-xs font-extrabold text-indigo-900 uppercase tracking-wide">Quick Taxonomy Verbs Helper:</h4>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                                <button type="button" onclick="insertVerb('Define, List, Name')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">1. Remember</strong> Define, Identify, Recall
                                </button>
                                <button type="button" onclick="insertVerb('Explain, Contrast, Summarize')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">2. Understand</strong> Interpret, Compare, Clarify
                                </button>
                                <button type="button" onclick="insertVerb('Apply, Practice, Implement')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">3. Apply</strong> Execute, Construct, Use
                                </button>
                                <button type="button" onclick="insertVerb('Analyze, Correlate, Deconstruct')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">4. Analyze</strong> Differentiate, Organize
                                </button>
                                <button type="button" onclick="insertVerb('Critique, Evaluate, Defend')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">5. Evaluate</strong> Judge, Support, Assess
                                </button>
                                <button type="button" onclick="insertVerb('Formulate, Devise, Synthesize')" class="text-left p-1.5 bg-white border border-indigo-200 rounded text-xs hover:bg-indigo-100 hover:border-indigo-400 transition">
                                    <strong class="block text-indigo-900">6. Create</strong> Design, Plan, Generate
                                </button>
                            </div>
                        </div>

                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Core Learning Objectives (one per line)</label>
                        <textarea id="learning-objectives" rows="3" placeholder="Upon completion of this lesson, students will be able to:&#10;- Bloom Verb: Action statement...&#10;- Bloom Verb: Action statement..." class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                    </div>

                    <!-- 3. Key Content Coverage -->
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center space-x-2 border-b border-slate-100 pb-2 mb-4">
                            <span class="bg-indigo-100 text-indigo-600 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold">3</span>
                            <span>Topics & Core Terms</span>
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Topics Covered</label>
                                <textarea id="topics-covered" rows="3" placeholder="List core sub-topics (e.g., SWOT matrix, external threats, regional business challenges)" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Key Terms & Frameworks</label>
                                <textarea id="key-terms" rows="3" placeholder="e.g., Competitive Advantage, Strategic Plan, SWOT, PESTEL Analysis" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Community-Tied Activity Preferences -->
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center space-x-2 border-b border-slate-100 pb-2 mb-4">
                            <span class="bg-indigo-100 text-indigo-600 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold">4</span>
                            <span>Interactive & Community-Tied Activities</span>
                        </h3>
                        
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Target Activity Formats</label>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700">
                                    <label class="flex items-center space-x-2 bg-slate-50 hover:bg-slate-100 p-2.5 rounded-lg border border-slate-200 cursor-pointer transition">
                                        <input type="checkbox" id="act-interactive" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                        <span>Interactive learning activities</span>
                                    </label>
                                    <label class="flex items-center space-x-2 bg-slate-50 hover:bg-slate-100 p-2.5 rounded-lg border border-slate-200 cursor-pointer transition">
                                        <input type="checkbox" id="act-case-study" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                        <span>Community-Centered Case Studies</span>
                                    </label>
                                    <label class="flex items-center space-x-2 bg-slate-50 hover:bg-slate-100 p-2.5 rounded-lg border border-slate-200 cursor-pointer transition">
                                        <input type="checkbox" id="act-labs" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                        <span>Practical Management Labs</span>
                                    </label>
                                    <label class="flex items-center space-x-2 bg-slate-50 hover:bg-slate-100 p-2.5 rounded-lg border border-slate-200 cursor-pointer transition">
                                        <input type="checkbox" id="act-local" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                        <span>Assessments Tied to Local Businesses</span>
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Local Focus Strategy</label>
                                <select id="local-strategy" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Conducting a fast-paced audit or observation of a small local storefront or regional chamber business.">Audit of a Local Storefront / Chamber Business</option>
                                    <option value="Analyzing local job boards and interviewing/observing a local community supervisor or shift lead.">Analyzing Local Job Openings & Supervisor Roles</option>
                                    <option value="Developing contingency and sustainability ideas for small family-run local enterprises facing economic pressures.">Designing Adaptations for Vulnerable Local Family Businesses</option>
                                    <option value="Reviewing local municipality budgets, community non-profit models, or local municipal structures.">Analyzing Local Non-Profit / Municipal Organizational Designs</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Pedagogical Safeguards (Mitigation, ADA, Analogies) -->
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center space-x-2 border-b border-slate-100 pb-2 mb-4">
                            <span class="bg-indigo-100 text-indigo-600 w-6 h-6 rounded-md flex items-center justify-center text-xs font-bold">5</span>
                            <span>Pedagogical Safeguards & Quality Rules</span>
                        </h3>
                        
                        <div class="space-y-4">
                            <!-- AI Cheat Mitigation Select -->
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between">
                                    <span>AI Use & Cheating Mitigation</span>
                                    <span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded-md font-bold uppercase">Critical</span>
                                </label>
                                <select id="ai-mitigation" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Include hyper-local context restrictions, highly personalized reflection connections to their own current workplace/life experiences, and multi-stage scaffolded outlines that LLMs cannot cleanly construct in one go. Require unique non-generic local examples.">Local Context + Personal Workplace Reflection + Multi-Stage scaffold</option>
                                    <option value="Require students to compare AI-generated generic SWOT/plans against raw visual observations of their actual neighborhood businesses, noting the inaccuracies of purely digital data models.">AI-vs-Reality Benchmarking (Observational Check)</option>
                                    <option value="Integrate a short 2-minute video presentation element or highly specific comparative reflections of local, live events rather than textbook situations.">Multimedia Reflection + Time-sensitive Regional Context</option>
                                </select>
                            </div>

                            <!-- ADA Compliance Toggle text -->
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">ADA Compliance & Universal Design (UDL)</label>
                                <select id="ada-compliance" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Ensure all tasks are highly structured with clear visual headers. Provide alternative prompt guidelines for non-visual learners, fully descriptive alt-text recommendations for diagrams/matrices, and multiple avenues to demonstrate competence (written, slides, or audio recording transcripts).">Universal Design for Learning (UDL): Text Alt-options + Mixed Media Pathways</option>
                                    <option value="Provide highly explicit text-only guides, simplify multi-step guidelines into sequential, clear steps, and ensure all links, video guides, or external resources utilize robust captions.">Caption-first + Sequential Checklist Pathways</option>
                                </select>
                            </div>

                            <!-- Analogies -->
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Analogies & Real-World Framing</label>
                                <select id="analogies" class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 px-3 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                    <option value="Generate practical analogies using everyday concepts such as planning family events, coordinating local sports leagues, managing personal budgets, or steering a visual roadmap.">Everyday life models (sports team coordinates, dynamic household budgets)</option>
                                    <option value="Connect core conceptual mechanics directly to modern digital ecosystems, like managing app development cycles, popular restaurant shifts, or dynamic retail chains.">Modern workplaces (gig-worker structures, high-frequency coffee shop rushes)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </form>
            </section>

            <!-- RIGHT PREVIEW PANEL (5 Columns - Fixed/Sticky on Desktop) -->
            <section class="lg:col-span-5 lg:sticky lg:top-24 space-y-6">
                
                <div class="bg-slate-900 text-slate-100 rounded-2xl shadow-xl border border-slate-800 overflow-hidden">
                    
                    <!-- Header Actions -->
                    <div class="bg-slate-950 p-4 border-b border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="flex h-3.5 w-3.5 items-center justify-center rounded-full bg-emerald-500 text-[9px] font-black text-emerald-950">✓</span>
                            <span class="text-xs uppercase font-extrabold tracking-widest text-slate-300">Generated AI Prompt</span>
                        </div>
                        <div class="flex space-x-2">
                            <button onclick="copyPrompt()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs py-1.5 px-3 rounded-lg flex items-center transition shadow-md shadow-emerald-900/40">
                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                                </svg>
                                Copy Prompt
                            </button>
                        </div>
                    </div>

                    <!-- Prompt Text Box -->
                    <div class="p-5 font-mono text-xs text-slate-300 leading-relaxed overflow-y-auto max-h-[500px]" id="prompt-output">
                        <!-- Dynamically Generated Prompt Will Live Here -->
                    </div>

                    <!-- Footer Details -->
                    <div class="bg-slate-950/60 p-4 border-t border-slate-800 text-slate-400 text-[11px] flex items-center justify-between">
                        <span>Structured for Claude, GPT-4o, and Gemini</span>
                        <span class="flex items-center text-teal-400 font-semibold">
                            <span class="h-1.5 w-1.5 rounded-full bg-teal-400 mr-1 animate-pulse"></span>
                            Live Sync Active
                        </span>
                    </div>
                </div>

                <!-- Custom Tips Card -->
                <div class="bg-white rounded-xl border border-slate-200 p-5 space-y-3">
                    <h4 class="text-xs font-bold uppercase text-slate-500 tracking-wider">How to use this generated prompt:</h4>
                    <ol class="text-xs text-slate-600 space-y-2 list-decimal pl-4">
                        <li>Load a syllabus module or fill in your current lesson topics manually.</li>
                        <li>Tweak the dynamic sliders/dropdowns to customize variables.</li>
                        <li>Click <strong>"Copy Prompt"</strong> (we'll notify you when it's copied!).</li>
                        <li>Paste into your AI assistant. The generated prompt instructs the model to play the role of an expert community college designer and produce high-engagement, fully-compliant lesson content.</li>
                    </ol>
                </div>
            </section>

        </div>
    </main>

    <!-- Custom Success Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none z-50">
        <div class="bg-slate-900 border border-slate-700 text-white py-3.5 px-5 rounded-xl shadow-2xl flex items-center space-x-3">
            <span class="bg-emerald-500 text-emerald-950 p-1 rounded-full">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </span>
            <div>
                <p class="font-extrabold text-sm leading-none">Copied Successfully!</p>
                <p class="text-slate-400 text-xs mt-1">Prompt loaded to your clipboard.</p>
            </div>
        </div>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        // Principles of Management Syllabus database embedded
        const syllabusDatabase = [
            {
                module: "Module 1: Introduction to Management & P-O-L-C",
                title: "Introduction to Management & Theoretical P-O-L-C Frameworks",
                topics: "- Definition of management and organizational goals\n- The 4 core functions of management (Planning, Organizing, Leading, Controlling)\n- Mintzberg's managerial roles and conceptual skills needed at differing hierarchical levels\n- Evolution of classical vs. modern behavioral management theories",
                terms: "P-O-L-C Framework, Managerial Roles, Technical vs. Conceptual Skills, Scientific Management, Hawthorne Studies",
                objectives: "- Recall and define the four key functions of management (P-O-L-C framework).\n- Differentiate between the technical, interpersonal, and conceptual skills required at varying levels of an organization.\n- Analyze historical management frameworks (e.g., Taylorism vs. Mayo's Human Relations) to explain modern organizational cultures."
            },
            {
                module: "Module 2: Ethics, Culture, & Social Responsibility",
