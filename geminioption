            const format = document.getElementById('format').value;
            const objectives = document.getElementById('learning-objectives').value || "[Specify Objectives]";
            const topics = document.getElementById('topics-covered').value || "[Specify Key Topics]";
            const terms = document.getElementById('key-terms').value || "[Specify Key Terms]";
